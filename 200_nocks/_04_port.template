Value INTERFACE (\S+)
Value STATUS (up|down|administratively down)
Value PROTOCOL (up|down)
Value DESCRIPTION (.+)
Value IP_ADDRESS (\d+\.\d+\.\d+\.\d+/\d+)
Value MTU (\d+)

Start
  ^${INTERFACE}\s+is\s+${STATUS},\s+line\s+protocol\s+is\s+${PROTOCOL} -> InterfaceBlock

InterfaceBlock
  ^\s+Description:\s+${DESCRIPTION}
  ^\s+Internet\s+address\s+is\s+${IP_ADDRESS}
  ^\s+MTU\s+${MTU}\s+bytes
  # 次のインターフェースが始まったら、現在のレコードを保存して同じ行をStartで再評価する
  ^\S+\s+is\s+ -> Continue.Record
  ^${INTERFACE}\s+is\s+${STATUS},\s+line\s+protocol\s+is\s+${PROTOCOL}
  # 空行が来たら1ブロック終了とみなして保存し、Startへ戻る
  ^$$ -> Record Start

